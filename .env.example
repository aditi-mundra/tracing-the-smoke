# Environment variables for Tracing the Smoke ML Pipeline and Web Application

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Data directories (relative to project root or absolute paths)
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts

# Optional API Keys for Live Sync (Open-Meteo & FIRMS Open Data do not require keys for standard archive)
# XKDR_API_KEY=your_xkdr_api_key_here
# NASA_FIRMS_MAP_KEY=your_firms_map_key_here
# CDS_API_KEY=your_cds_api_key_here
