diff --git a/src/models/counterfactual.py b/src/models/counterfactual.py
new file mode 100644
index 0000000..a39e5e3
--- /dev/null
+++ b/src/models/counterfactual.py
@@ -0,0 +1,85 @@
+"""Model-based counterfactual scenarios for reduced Punjab-Haryana fire activity.
+
+Reuses the already trained Exp C model and preprocessing. Only fire-dependent
+inputs are scaled; every other input stays at its observed value. Results are
+model-based scenarios, not proven causal effects.
+"""
+
+import numpy as np
+import pandas as pd
+
+SCENARIO_REDUCTIONS = [25, 50, 75, 100]
+
+# Exp C fire inputs that scale in proportion to the number of fires removed.
+SCALABLE_FIRE_FEATURES = ["fire_count_total", "fire_count_upwind", "fire_upwind_weighted_frp"]
+
+DISCLAIMER = (
+    "Model-based counterfactual scenario, not a proven causal effect. Fire inputs are scaled "
+    "and all other inputs (including previous-day PM2.5) are held at observed values. "
+    "A given percentage cut in fires does not imply the same percentage cut in PM2.5."
+)
+
+
+def add_pm25_lags(df: pd.DataFrame) -> pd.DataFrame:
+    """Add pm25_lag1 / pm25_lag2 (same definition as scripts/build_final_ml_dataset.py) if missing."""
+    df = df.copy()
+    dates = pd.to_datetime(df["date_str"])
+    pm25 = pd.Series(df["delhi_daily_pm25_ugm3"].values, index=dates)
+    pm25[~df["cpcb_valid"].values] = np.nan
+    for days in (1, 2):
+        name = f"pm25_lag{days}"
+        if name not in df.columns:
+            df[name] = pm25.shift(days, freq="D").reindex(dates).values
+    return df
+
+
+def apply_fire_reduction(row: pd.Series, feature_cols: list, reduction_pct: float) -> pd.Series:
+    """Return a copy of row with every fire-dependent model input reduced by reduction_pct."""
+    if not 0 <= reduction_pct <= 100:
+        raise ValueError(f"reduction_pct must be between 0 and 100, got {reduction_pct}")
+
+    fire_cols = [c for c in feature_cols if "fire" in c]
+    unsupported = [c for c in fire_cols if c not in SCALABLE_FIRE_FEATURES]
+    if unsupported:
+        raise ValueError(f"Cannot scale fire features consistently: {unsupported}")
+
+    scenario_row = row.copy()
+    for col in fire_cols:
+        value = scenario_row[col]
+        if pd.isna(value) or value < 0:
+            raise ValueError(f"Invalid fire input {col}={value}")
+        scenario_row[col] = float(value) * (1 - reduction_pct / 100)
+    return scenario_row
+
+
+def predict_pm25(model, imputer, scaler, feature_cols: list, row: pd.Series) -> float:
+    """Predict PM2.5 for one row exactly as DataService.run_inference does."""
+    X = imputer.transform(pd.DataFrame([row[feature_cols]], columns=feature_cols))
+    if scaler is not None:
+        X = scaler.transform(X)
+    return float(model.predict(X)[0])
+
+
+def compare_predictions(baseline: float, scenario: float) -> dict:
+    """Absolute and percentage difference; percentage is None if the baseline is unusable."""
+    difference = scenario - baseline
+    baseline_is_valid = np.isfinite(baseline) and baseline > 0
+    percent = difference / baseline * 100 if baseline_is_valid else None
+    return {
+        "baseline_pm25": baseline,
+        "scenario_pm25": scenario,
+        "absolute_difference": difference,
+        "percent_difference": percent,
+    }
+
+
+def simulate_fire_reduction(model, imputer, scaler, feature_cols: list, row: pd.Series) -> dict:
+    """Run the baseline and every scenario in SCENARIO_REDUCTIONS for one date's inputs."""
+    baseline = predict_pm25(model, imputer, scaler, feature_cols, row)
+    scenarios = []
+    for reduction_pct in SCENARIO_REDUCTIONS:
+        scenario_row = apply_fire_reduction(row, feature_cols, reduction_pct)
+        scenario = predict_pm25(model, imputer, scaler, feature_cols, scenario_row)
+        result = compare_predictions(baseline, scenario)
+        scenarios.append({"fire_reduction_pct": reduction_pct, **result})
+    return {"baseline_pm25": baseline, "scenarios": scenarios}
diff --git a/tests/test_counterfactual.py b/tests/test_counterfactual.py
new file mode 100644
index 0000000..0c0e167
--- /dev/null
+++ b/tests/test_counterfactual.py
@@ -0,0 +1,109 @@
+"""Tests for the model-based fire-reduction counterfactual scenarios."""
+
+import numpy as np
+import pandas as pd
+import pytest
+import xgboost as xgb
+from fastapi.testclient import TestClient
+from sklearn.impute import SimpleImputer
+
+from backend.app.main import app
+from backend.app.services.data_service import data_service
+from src.models.counterfactual import (
+    SCENARIO_REDUCTIONS,
+    SCALABLE_FIRE_FEATURES,
+    apply_fire_reduction,
+    compare_predictions,
+    predict_pm25,
+    simulate_fire_reduction,
+)
+
+client = TestClient(app)
+DATE = "2024-11-18"
+
+
+@pytest.fixture(scope="module")
+def pipeline():
+    """Small XGBoost model fitted on the real Exp C training rows (2018-2022)."""
+    df = data_service.ml_dataset
+    feats = data_service.feature_lists["exp_c_engineered_fires"]
+    train = df[df["year"].between(2018, 2022)]
+    imputer = SimpleImputer(strategy="median")
+    X_train = imputer.fit_transform(train[feats])
+    model = xgb.XGBRegressor(n_estimators=40, max_depth=3, random_state=42)
+    model.fit(X_train, train["delhi_daily_pm25_ugm3"].values)
+    row = df[df["date_str"] == DATE].iloc[0]
+    return model, imputer, feats, row
+
+
+def test_zero_reduction_matches_baseline(pipeline):
+    model, imputer, feats, row = pipeline
+    baseline = predict_pm25(model, imputer, None, feats, row)
+    unchanged = apply_fire_reduction(row, feats, 0)
+    assert predict_pm25(model, imputer, None, feats, unchanged) == baseline
+
+
+def test_only_fire_inputs_change(pipeline):
+    model, imputer, feats, row = pipeline
+    scenario = apply_fire_reduction(row, feats, 50)
+    for col in feats:
+        if col in SCALABLE_FIRE_FEATURES:
+            assert scenario[col] == pytest.approx(row[col] * 0.5)
+        else:
+            assert scenario[col] == row[col] or (pd.isna(scenario[col]) and pd.isna(row[col]))
+    assert apply_fire_reduction(row, feats, 100)[SCALABLE_FIRE_FEATURES].eq(0).all()
+    assert row["fire_count_total"] == 1845  # original row not mutated
+
+
+def test_invalid_inputs_raise(pipeline):
+    _, _, feats, row = pipeline
+    with pytest.raises(ValueError):
+        apply_fire_reduction(row, feats, 101)
+    with pytest.raises(ValueError):
+        apply_fire_reduction(row, feats, -5)
+    bad_row = row.copy()
+    bad_row["fire_count_total"] = np.nan
+    with pytest.raises(ValueError):
+        apply_fire_reduction(bad_row, feats, 25)
+    with pytest.raises(ValueError):  # a fire feature we do not know how to scale
+        apply_fire_reduction(row, feats + ["fire_count_total_lag1"], 25)
+
+
+def test_output_calculations():
+    result = compare_predictions(200.0, 150.0)
+    assert result["absolute_difference"] == -50.0
+    assert result["percent_difference"] == -25.0
+    for bad_baseline in (0.0, -10.0, float("nan"), float("inf")):
+        assert compare_predictions(bad_baseline, 100.0)["percent_difference"] is None
+
+
+def test_simulation_output_structure(pipeline):
+    model, imputer, feats, row = pipeline
+    result = simulate_fire_reduction(model, imputer, None, feats, row)
+    assert [s["fire_reduction_pct"] for s in result["scenarios"]] == SCENARIO_REDUCTIONS
+    assert result["baseline_pm25"] == predict_pm25(model, imputer, None, feats, row)
+    for s in result["scenarios"]:
+        assert s["baseline_pm25"] == result["baseline_pm25"]
+        assert s["absolute_difference"] == pytest.approx(s["scenario_pm25"] - s["baseline_pm25"])
+
+
+def test_api_unknown_date_and_bad_model():
+    assert client.post("/api/simulate/fire-reduction", json={"date": "1999-01-01"}).status_code == 404
+    assert client.post("/api/simulate/fire-reduction", json={"date": DATE, "model_name": "nope"}).status_code == 400
+
+
+def test_api_reports_missing_model_artifacts(monkeypatch):
+    monkeypatch.setattr(data_service, "models", {})
+    response = client.post("/api/simulate/fire-reduction", json={"date": DATE})
+    assert response.status_code == 503
+    assert "missing" in response.json()["detail"]
+
+
+def test_api_baseline_matches_predict_endpoint():
+    if "xgboost" not in data_service.models or "exp_c" not in data_service.imputers:
+        pytest.skip("Trained Exp C artifacts not found in artifacts/final_models/")
+    sim = client.post("/api/simulate/fire-reduction", json={"date": DATE}).json()
+    pred = client.post("/api/predict", json={"mode": "historical_retrospective", "date": DATE}).json()
+    assert sim["baseline_pm25"] == pytest.approx(pred["predicted_pm25"], abs=0.01)
+    assert len(sim["scenarios"]) == 4
+    assert "not a proven causal effect" in sim["scientific_disclaimer"]
